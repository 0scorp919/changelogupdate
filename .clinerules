    '-F', SSH_CONFIG,
    '-o', 'StrictHostKeyChecking=no', '-o', 'BatchMode=yes', 'git@github.com'
], capture_output=True, text=True, timeout=12)
print(r.stdout + r.stderr)  # → Hi oleksii-rovnianskyi! You've successfully authenticated...
```

