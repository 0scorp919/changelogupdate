    """SHA256 self-integrity check."""
    import hashlib
    with open(__file__, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()[:12]

def ensure_dependencies():
    """Self-healing pip install for local scripts only."""
    # Only for local scripts, NEVER for Docker/CI/CD/production
    pass

def cleanup_old_logs(days=7, max_size_mb=50.0):
    """Log rotation: 7 days retention, >50MB → _partN."""
    # Current day is NEVER deleted
    pass

def manage_backups():
    """AES-256 encrypted backup + rotation (7 daily + 4 weekly)."""
    # Password mandatory — if missing → ERROR + skip backup
    pass
```

## Correct use of replace_in_file vs write_to_file
```python
# ❌ INCORRECT — write_to_file for small change
# (unnecessary rewriting of entire file)

# ✅ CORRECT — replace_in_file for small change
# SEARCH/REPLACE block for precise change
diff = '''-------
def old_function():
    return "old"
=======
def new_function():
    return "new"
+++++++ REPLACE'''

# ✅ CORRECT — write_to_file for large change or new file
# (CHANGED lines >= 200 or file is new)
```

## Rule conflict resolution — example
```python
# Situation: User requests adding hardcoded path
# Rule: <project_portability_standard> forbids hardcoding

# Step 1: Identify conflict
print("This contradicts project_portability_standard rule (hardcoding forbidden).")

# Step 2: Propose options
print("Option A: Make an exception for this specific case")
print("Option B: Update the rule in .clinerules for future cases")

# Step 3: Wait for confirmation
# Without confirmation — do not execute action
```

## Working with .env files
```python
# ❌ INCORRECT — secrets in code
API_KEY = "sk-1234567890abcdef"
DB_PASSWORD = "SuperSecret123!"

# ✅ CORRECT — .env file (gitignored)
# .env (not committed):
API_KEY=sk-1234567890abcdef
DB_PASSWORD=SuperSecret123!

# .env.example (committed):
API_KEY=your_openai_api_key_here
DB_PASSWORD=your_database_password_here

# Code:
import os
from dotenv import load_dotenv
load_dotenv()
API_KEY = os.getenv("API_KEY")
DB_PASSWORD = os.getenv("DB_PASSWORD")
```

## Handling edge cases
```python
# Situation: replace_in_file doesn't find match
try:
    replace_in_file(...)
except MatchNotFound:
    # 1. read_file to check exact formatting (auto-format might have altered it)
    read_file(...)
    # 2. adjust SEARCH block and retry
    retry_with_adjusted_whitespace(...)
    # 3. DO NOT fallback to write_to_file immediately
```
